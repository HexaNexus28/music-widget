{
  "name": "my-widget-app",
  "main": "main.js",
  "type": "module",
  "version": "1.0.0",
  "description": "A desktop application with a widget using Electron and React",
  "author": "HexaNexus",
  "scripts": {
    "dev": "vite dev & electron .",
    "build": "vite build && electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.hexanexus.mywidgetapp",
    "productName": "Music-Widget App",
    "files": [
      "dist/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/my-icon.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/react-youtube": "^7.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react-hooks/recommended"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}